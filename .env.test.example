# Optional test-only overrides. Do not commit a real .env.test file.
# The test runner always enforces DB_NAME=gamemarket_test.
NODE_ENV=test
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gamemarket_test
DB_USER=gamemarket_test_runner
DB_PASSWORD=replace_with_a_test_database_password
JWT_ACCESS_SECRET=replace_with_a_test_only_secret
JWT_REFRESH_SECRET=replace_with_a_different_test_only_secret
ACCOUNT_MODE=SPLIT
EMAIL_ENABLED=false
