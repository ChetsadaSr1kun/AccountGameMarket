NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000,https://organizer-res-announces-width.trycloudflare.com
FRONTEND_URL=https://organizer-res-announces-width.trycloudflare.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gamemarket
DB_USER=gamemarket_app
DB_PASSWORD=replace_with_a_strong_password

# Generate long random values for production. Never commit the real .env file.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Required in production for HMAC-SHA256 email-verification OTP hashes.
VERIFICATION_OTP_SECRET=replace_with_a_third_long_random_secret

# UNIFIED gives a registered user CUSTOMER + SELLER roles.
# SPLIT lets a user choose CUSTOMER or SELLER during registration.
ACCOUNT_MODE=SPLIT

# ─── Email delivery ──────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true to send real emails via SMTP.
# Leave false for development without Mailpit, and always false in automated tests.
EMAIL_ENABLED=false

# SMTP settings — required when EMAIL_ENABLED=true.
# Development (Mailpit):  SMTP_HOST=127.0.0.1  SMTP_PORT=1025  (no auth needed)
# Production example:     SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS delivery ───────────────────────────────────────────────────────────
# disabled: no SMS is sent. development: writes an OTP-only local inbox file;
# it is refused in production. provider is a future adapter integration point.
SMS_MODE=disabled
# Used only by SMS_MODE=development; this directory is gitignored.
SMS_DEV_INBOX_DIR=tmp/sms-inbox

# Use only with npm.cmd run db:create-admin. Do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# ─── SlipOK bank-transfer slip verification ─────────────────────────────────
# Keep the real API key only in .env on the server. Never expose it to the browser.
SLIPOK_API_KEY=replace_with_slipok_api_key
SLIPOK_BRANCH_ID=replace_with_slipok_branch_id
SLIPOK_RECEIVER_NAME=replace_with_receiver_name
SLIPOK_RECEIVER_BANK=replace_with_receiver_bank
SLIPOK_RECEIVER_ACCOUNT=replace_with_receiver_account
SLIPOK_RECEIVER_PROMPTPAY=replace_with_receiver_promptpay
SLIPOK_RECEIVER_TRUEMONEY=replace_with_receiver_truemoney

# ─── Riot / Valorant account verification ────────────────────────────────────
# Keep the real API key only in .env on the server.
# Never expose RIOT_API_KEY to frontend JavaScript.
RIOT_API_KEY=
RIOT_ACCOUNT_BASE_URL=https://asia.api.riotgames.com