NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gamemarket
DB_USER=gamemarket_app
DB_PASSWORD=replace_with_a_strong_password

# Generate long random values for production. Never commit the real .env file.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Required in production for HMAC-SHA256 email-verification OTP hashes.
VERIFICATION_OTP_SECRET=replace_with_a_third_long_random_secret

# UNIFIED gives a registered user CUSTOMER + SELLER roles.
# SPLIT lets a user choose CUSTOMER or SELLER during registration.
ACCOUNT_MODE=SPLIT

# ─── Email delivery ──────────────────────────────────────────────────────────
# Set EMAIL_ENABLED=true to send real emails via SMTP.
# Leave false for development without Mailpit, and always false in automated tests.
EMAIL_ENABLED=false

# SMTP settings — required when EMAIL_ENABLED=true.
# Development (Mailpit):  SMTP_HOST=127.0.0.1  SMTP_PORT=1025  (no auth needed)
# Production example:     SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Use only with npm.cmd run db:create-admin. Do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
